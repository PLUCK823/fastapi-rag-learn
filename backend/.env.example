# ── 数据库（默认 PostgreSQL）───────────────────────
# 本地开发（Docker PostgreSQL）
DATABASE_URL=postgresql+asyncpg://raguser:devpassword@localhost:5432/raglearn
# Docker 部署
# DATABASE_URL=postgresql+asyncpg://raguser:${DB_PASSWORD}@db:5432/raglearn
# CI 测试
# DATABASE_URL=postgresql+asyncpg://raguser:citest@localhost:5432/raglearn

# DB 密码（Docker 部署时需要）
DB_PASSWORD=change-me-in-production

# ── LLM ──────────────────────────────────────────────
OPENAI_API_KEY=sk-your-api-key
OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash

# ── 安全 ─────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-secret-string
